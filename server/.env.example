# ==========================================================
# MYNTRAAI SERVER ENVIRONMENT
# Keep real keys in server/.env only. Never commit or share that file.
# ==========================================================
PORT=5000
MONGODB_URI=
MONGODB_DB_NAME=myntra_ai_tryon
NANOBANANA_API_KEY=
# Public HTTPS URL pointing to this backend. For localhost development, use an HTTPS tunnel to port 5000.
NANOBANANA_PUBLIC_BASE_URL=
# Optional. Defaults to <NANOBANANA_PUBLIC_BASE_URL>/api/tryon/nanobanana/callback
NANOBANANA_CALLBACK_URL=
# Set true for local HTTPS tunnel development to block other API routes through the public tunnel.
NANOBANANA_TUNNEL_RESTRICT_MODE=true
CLIENT_ORIGIN=http://localhost:5173
DEBUG_SAVE_TRYON_INPUTS=false
